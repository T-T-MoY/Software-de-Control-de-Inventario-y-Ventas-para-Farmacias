        {
          "name": "Seleccionar medicamentos disponibles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo de venta disponible', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const libres = rows.filter(m => m.tipo_venta === 'Libre' && Number(m.stock_disponible) > 0);",
                  "const libre = libres[0];",
                  "const receta = rows.find(m => m.tipo_venta === 'Con receta' && Number(m.stock_disponible) > 0);",
                  "pm.expect(libres.length, 'Se requieren tres productos libres con stock para CP-08').to.be.at.least(3);",
                  "pm.expect(receta, 'Debe existir un medicamento con receta y stock').to.exist;",
                  "pm.environment.set('medicamentoLibre', libre.id_medicamento);",
                  "pm.environment.set('precioLibre', libre.precio_unitario);",
                  "pm.environment.set('stockLibreInicial', libre.stock_disponible);",
                  "pm.environment.set('medicamentoLibre2', libres[1].id_medicamento);",
                  "pm.environment.set('precioLibre2', libres[1].precio_unitario);",
                  "pm.environment.set('medicamentoLibre3', libres[2].id_medicamento);",
                  "pm.environment.set('precioLibre3', libres[2].precio_unitario);",
                  "pm.environment.set('medicamentoReceta', receta.id_medicamento);",
                  "pm.environment.set('precioReceta', receta.precio_unitario);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVentas}}"
              }
            ],
            "url": {
