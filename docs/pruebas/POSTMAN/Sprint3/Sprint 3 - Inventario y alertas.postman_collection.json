              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado de proveedores disponible', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.expect(rows).to.be.an('array');",
                  "pm.expect(rows.some(p => Number(p.id_proveedor) === Number(pm.environment.get('proveedorPrueba')))).to.eql(true);"
                ]
