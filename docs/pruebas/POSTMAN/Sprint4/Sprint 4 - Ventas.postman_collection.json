        {
          "name": "Rechazar cantidad superior al stock",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stock = Number(pm.environment.get('stockLibreInicial'));",
                  "pm.environment.set('cantidadExcesiva', stock + 100);",
                  "pm.environment.set('montoExcesivo', (Number(pm.environment.get('precioLibre')) * (stock + 100) + 1).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock insuficiente rechazado sin confirmar venta', () => pm.response.to.have.status(409));",
                  "pm.expect(pm.response.json().error).to.be.a('string');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVentas}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id_cliente\":\"{{clientePrueba}}\",\"items\":[{\"id_medicamento\":\"{{medicamentoLibre}}\",\"cantidad\":\"{{cantidadExcesiva}}\"}],\"descuento_porcentaje\":0,\"monto_recibido\":\"{{montoExcesivo}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "CP-08 Registrar una venta de tres productos en menos de tres minutos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const total = ['precioLibre', 'precioLibre2', 'precioLibre3'].reduce((sum, key) => sum + Number(pm.environment.get(key)), 0);",
                  "pm.environment.set('montoVentaTresProductos', (total + 1).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Venta de tres productos registrada', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json().venta;",
                  "pm.expect(v.items).to.have.lengthOf(3);",
                  "pm.expect(pm.response.responseTime).to.be.below(180000);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVentas}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id_cliente\":\"{{clientePrueba}}\",\"items\":[{\"id_medicamento\":\"{{medicamentoLibre}}\",\"cantidad\":1},{\"id_medicamento\":\"{{medicamentoLibre2}}\",\"cantidad\":1},{\"id_medicamento\":\"{{medicamentoLibre3}}\",\"cantidad\":1}],\"descuento_porcentaje\":0,\"monto_recibido\":\"{{montoVentaTresProductos}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
