              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('montoVentaReceta', (Number(pm.environment.get('precioReceta')) + 1).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Venta con receta registrada', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json().venta;",
                  "pm.expect(v.items[0].id_medicamento).to.eql(Number(pm.environment.get('medicamentoReceta')));",
                  "pm.expect(v.tipo_comprobante).to.eql('Factura');",
                  "pm.expect(v.num_serie).to.match(/^F-/);",
                  "pm.expect(Number(v.cambio)).to.be.above(0);",
                  "pm.expect(pm.response.json().farmacia).to.be.an('object');"
                ]
              }
            }
