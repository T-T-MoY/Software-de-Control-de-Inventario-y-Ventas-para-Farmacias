        {
          "name": "Registrar recepción de lote próximo a vencer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 10);",
                  "pm.environment.set('fechaVencimientoPrueba', d.toISOString().slice(0, 10));",
                  "pm.environment.set('lotePrueba', 'SP3-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recepción registrada', () => pm.response.to.have.status(201));",
                  "const lote = pm.response.json().lote;",
                  "pm.expect(lote.id_lote).to.exist;",
                  "pm.expect(lote.lote_numero).to.eql(pm.environment.get('lotePrueba'));",
                  "pm.environment.set('idLotePrueba', lote.id_lote);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInventario}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id_medicamento\":\"{{medicamentoPrueba}}\",\"id_proveedor\":\"{{proveedorPrueba}}\",\"lote_numero\":\"{{lotePrueba}}\",\"fecha_vencimiento\":\"{{fechaVencimientoPrueba}}\",\"costo_unitario\":1.25,\"cantidad_stock\":5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
