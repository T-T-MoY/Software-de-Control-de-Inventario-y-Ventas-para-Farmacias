          "name": "Reporte de ventas con rango válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reporte de ventas generado', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.expect(r.tipo).to.eql('ventas');",
                  "pm.expect(r.columnas).to.be.an('array').that.is.not.empty;",
                  "pm.expect(r.filas).to.be.an('array');",
                  "pm.expect(r.totales).to.be.an('object');",
                  "pm.expect(r.total_filas).to.eql(r.filas.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
