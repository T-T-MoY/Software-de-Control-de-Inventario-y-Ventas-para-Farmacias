          "name": "Verificar recepción en historial de auditoría",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recepciones aparecen en historial', () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.expect(h.registros.some(r => r.tipo_operacion === 'RECEPCION' && Number(r.id_registro) === Number(pm.environment.get('idLotePrueba')))).to.eql(true);"
