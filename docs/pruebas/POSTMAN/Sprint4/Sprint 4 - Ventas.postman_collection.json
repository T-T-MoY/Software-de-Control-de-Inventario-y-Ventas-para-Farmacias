        {
          "name": "Venta con descuento, cambio y nota de venta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const price = Number(pm.environment.get('precioLibre'));",
                  "pm.environment.set('montoVentaLibre', (price * 2).toFixed(2));",
                  "pm.environment.set('totalEsperadoLibre', (price * 0.9).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Venta registrada', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json().venta;",
                  "pm.expect(v.id_venta).to.exist;",
                  "pm.expect(Number(v.subtotal)).to.be.closeTo(Number(pm.environment.get('precioLibre')), 0.01);",
                  "pm.expect(Number(v.descuento_monto)).to.be.closeTo(Number(pm.environment.get('precioLibre')) * 0.1, 0.01);",
                  "pm.expect(Number(v.total)).to.be.closeTo(Number(pm.environment.get('totalEsperadoLibre')), 0.01);",
                  "pm.expect(Number(v.cambio)).to.be.above(0);",
                  "pm.expect(v.tipo_comprobante).to.eql('Nota de venta');",
                  "pm.expect(v.num_serie).to.match(/^NV-/);",
                  "pm.environment.set('idVentaPrueba', v.id_venta);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVentas}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id_cliente\":\"{{clientePrueba}}\",\"items\":[{\"id_medicamento\":\"{{medicamentoLibre}}\",\"cantidad\":1}],\"descuento_porcentaje\":10,\"monto_recibido\":\"{{montoVentaLibre}}\",\"tipo_comprobante\":\"Nota de venta\",\"formato_impresion\":\"Pantalla\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
