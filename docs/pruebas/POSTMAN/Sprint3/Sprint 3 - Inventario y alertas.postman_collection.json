        {
          "name": "Buscar medicamento para recepción",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo consultable', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.expect(rows).to.be.an('array').that.is.not.empty;",
                  "const m = rows.find(x => x.estado_medicamento === 'Activo') || rows[0];",
                  "pm.environment.set('medicamentoPrueba', m.id_medicamento);"
                ]
              }
            }
          ],
