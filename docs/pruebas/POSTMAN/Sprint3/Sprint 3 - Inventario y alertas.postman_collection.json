    {
      "name": "1. CP-03 Proveedores y recepción de lotes",
      "item": [
        {
          "name": "Registrar proveedor de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('rucPrueba', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Proveedor creado', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json().proveedor;",
                  "pm.expect(p.id_proveedor).to.exist;",
                  "pm.environment.set('proveedorPrueba', p.id_proveedor);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInventario}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_comercial\":\"Proveedor Sprint 3\",\"ruc_nit\":\"{{rucPrueba}}\",\"telefono\":\"22112233\",\"correo_electronico\":\"sprint3@farmacia.bo\",\"direccion\":\"La Paz\"}",
