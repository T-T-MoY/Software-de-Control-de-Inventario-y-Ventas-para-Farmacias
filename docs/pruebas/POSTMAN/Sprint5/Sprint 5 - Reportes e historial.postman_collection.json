        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.expect(b.usuario.rol).to.eql('Administrador');",
                  "pm.environment.set('tokenAdmin', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@farmacia.bo\",\"password\":\"{{passwordDemo}}\"}",
              "options": {
                "raw": {
                  "language": "json"
