        {
          "name": "Confirmar descuento de una unidad del stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo actualizado', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const m = rows.find(x => Number(x.id_medicamento) === Number(pm.environment.get('medicamentoLibre')));",
                  "pm.expect(m).to.exist;",
                  "pm.expect(Number(m.stock_disponible)).to.eql(Number(pm.environment.get('stockLibreInicial')) - 1);"
                ]
              }
            }
