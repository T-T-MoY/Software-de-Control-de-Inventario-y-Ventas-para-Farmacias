POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=control_farmacia
SESSION_SECRET=reemplaza-por-una-clave-aleatoria-de-al-menos-32-caracteres
PGADMIN_DEFAULT_EMAIL=admin@farmacia.local
PGADMIN_DEFAULT_PASSWORD=cambia-esta-clave-local

# --- Despliegue en la nube (Neon + Render) ---
# En local no hacen falta: docker-compose asigna DB_* al contenedor del backend.
# DB_HOST=ep-xxx.us-west-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=tu-clave-de-neon
# DB_SSL=true
# DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# FRONTEND_ORIGIN=https://tu-app.vercel.app

# Parámetros generales del sistema
MARGEN_ALERTA_DIAS=30
STOCK_SEGURIDAD=10
# Días de reposición por defecto para nuevos medicamentos
DIAS_REPOSICION=5
# Ventana en días para calcular la demanda diaria promedio
VENTANA_DEMANDA_DIAS=30
FARMACIA_NOMBRE=Farmacia Central
FARMACIA_NIT=1234567890
FARMACIA_DIRECCION="Av. Principal #123, La Paz"
FARMACIA_TELEFONO=22233344
